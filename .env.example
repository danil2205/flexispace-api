# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_PORT=5432
DB_HOST=localhost
DB_NAME=flexispace
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SYNC=true
DB_AUTOLOAD=true
DB_MIGRATIONS_RUN=false

# Authentication & JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_32_characters_long
JWT_AUDIENCE=localhost:3000
JWT_ISSUER=localhost:3000
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400

# AWS S3 / MinIO Storage
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=flexispace-images
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT=http://localhost:9000

# Redis Cache & Queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL=60000
REDIS_DB=0

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# SMTP Mail Server (Mailtrap / Production SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SENDER=hello@flexispace.com
SMTP_TOKEN=your_mailtrap_token

# Rate Limiting & Throttling
THROTTLING_WINDOW_MS=60000
THROTTLING_LIMIT=10
